# Hostinger: public_html = مجلد المشروع. بدون أي تحويل لـ /public/
DirectoryIndex index.php
Options -Indexes -MultiViews
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # تمرير التوكن للـ API
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1) الملفات الثابتة (css, js, img, storage) تنخدم من public
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # 2) منع الوصول المباشر لملفات الكود والإعدادات
    # /app و /app/download صفحات المنصة، باقي app/ ممنوع
    RewriteRule ^app/(?!download/).+ - [F,L]
    RewriteRule ^(bootstrap|config|database|lang|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]
    RewriteRule ^\. - [F,L]

    # 3) كل الباقي للمنصة
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.env|composer\.(json|lock)$|artisan$|\.(log|sqlite|md)$">
    Require all denied
</FilesMatch>
