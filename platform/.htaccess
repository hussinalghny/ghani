# لما يكون public_html هو مجلد المشروع نفسه (Hostinger)
# الصفحة الرئيسية تروح مباشرة لـ index.php (بدون ما السيرفر يحول لـ /public/)
<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    DirectorySlash Off
    RewriteEngine On
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>

<FilesMatch "^\.env|composer\.(json|lock)$|artisan$">
    Require all denied
</FilesMatch>
