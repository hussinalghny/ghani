APP_NAME="غني أكاديمي"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Baghdad
APP_URL=https://academy.ghanicode.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ghani_academy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Bunny Stream (الفيديوهات) ----
# Stream > Library > API: رقم المكتبة ومفتاح API
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# Stream > Library > Security > Embed view token authentication key
BUNNY_EMBED_TOKEN_KEY=
# Pull zone الخاص بالمكتبة (مثال: vz-xxxx.b-cdn.net) + مفتاح Token Authentication بتاعه (للتطبيق HLS)
BUNNY_CDN_HOST=
BUNNY_CDN_TOKEN_KEY=
# صلاحية الرابط بالدقائق
BUNNY_TOKEN_TTL=120

# ---- الأدمن الأول (للـ seeder) ----
ADMIN_PHONE=07766637444
ADMIN_PASSWORD=ChangeMe@2026
